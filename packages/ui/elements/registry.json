      "dependencies": ["ai", "react"],
      "registryDependencies": [],
      "files": [
        {
          "path": "src/message.tsx",
          "type": "registry:component"
        },
        {
          "path": "src/util/cn.ts",
          "type": "registry:lib"
        }
      ]
    },
    {
      "name": "prompt-input",
      "type": "registry:component",
      "title": "PromptInput",
      "description": "Chat input form with Enter-to-send and controlled/uncontrolled modes.",
      "dependencies": ["react"],
      "registryDependencies": [],
      "files": [
        {
          "path": "src/prompt-input.tsx",
          "type": "registry:component"
        },
        {
          "path": "src/util/cn.ts",
          "type": "registry:lib"
        }
      ]
    }
  ]
