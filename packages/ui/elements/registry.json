{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "@ai-toolkit/elements",
  "homepage": "https://studio.khulnasoft.com/docs",
  "items": [
    {
      "name": "conversation",
      "type": "registry:component",
      "title": "Conversation",
      "description": "Scrollable conversation container with auto-scroll for AI chat UIs.",
      "dependencies": ["react"],
      "registryDependencies": [],
