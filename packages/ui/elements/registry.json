        {
          "path": "src/conversation.tsx",
          "type": "registry:component"
        },
        {
          "path": "src/util/cn.ts",
          "type": "registry:lib"
        }
      ]
    },
    {
      "name": "message",
      "type": "registry:component",
      "title": "Message",
